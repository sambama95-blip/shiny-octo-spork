[
  {
    "id": "sap",
    "name": "SAP HCM extract → load",
    "blurb": "Common SAP payroll extract columns into a flat load template. Tax / wage type codes stay as provided.",
    "fields": [
      {
        "key": "PERNR",
        "label": "Personnel number",
        "required": true,
        "hint": "Employee ID / PERNR"
      },
      {
        "key": "BUKRS",
        "label": "Company code",
        "required": true
      },
      {
        "key": "WERKS",
        "label": "Personnel area",
        "required": false
      },
      {
        "key": "BEGDA",
        "label": "Begin date",
        "required": true,
        "hint": "YYYYMMDD or ISO"
      },
      {
        "key": "ENDDA",
        "label": "End date",
        "required": false
      },
      {
        "key": "LGART",
        "label": "Wage type",
        "required": true,
        "neverInvent": true,
        "hint": "Must exist in source — never invent"
      },
      {
        "key": "BETRG",
        "label": "Amount",
        "required": true
      },
      {
        "key": "ANZHL",
        "label": "Number / hours",
        "required": false
      },
      {
        "key": "WAERS",
        "label": "Currency",
        "required": false
      },
      {
        "key": "TAX_CODE",
        "label": "Tax code",
        "required": false,
        "neverInvent": true,
        "hint": "Pass-through only"
      }
    ]
  },
